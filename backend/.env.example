LOG_LEVEL=info
ANAKIN_API_KEY=your_anakin_api_key
ANAKIN_BASE_URL=https://api.anakin.io/v1
ANAKIN_POLL_SECONDS=3
ANAKIN_POLL_TIMEOUT_SECONDS=120
ANAKIN_AGENTIC_POLL_SECONDS=10
ANAKIN_AGENTIC_POLL_TIMEOUT_SECONDS=600
# Hard ceiling for the whole /analyze call; partial memo is returned if exceeded.
ANALYZE_TOTAL_DEADLINE_SECONDS=120
ANALYZE_MAP_DEADLINE_SECONDS=35
# Wire (Holocron) — optional; runs in parallel with scrape + agentic. Comma-separated catalog slugs from GET /holocron/catalog
HOLOCRON_ENABLED=true
HOLOCRON_CATALOG_SLUGS=wikipedia,google_news
HOLOCRON_POLL_SECONDS=2
HOLOCRON_POLL_TIMEOUT_SECONDS=180
HOLOCRON_BETWEEN_CATALOG_SECONDS=0.75
# Gemini polish layer (optional). Rewrites memo into analyst tone; gracefully skipped if disabled.
GEMINI_ENABLED=false
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=20
STOCK_HISTORY_DAYS=30
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
